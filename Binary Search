class Solution {
 public int search(int[] arr, int target) {
     int left =0;
    int right = arr.length-1;

        while(left <= right){
        int mid = left+(right-left)/2;
          if(arr[mid] == target){
           return mid;
            }
     else if(arr[mid]<target){
            left = mid+1;
            }
        else {
            right = mid-1;
        }
        }
    return -1;
}
}
// arr[mid] == target → found → return mid
// arr[mid] < target → target is on right side
// arr[mid] > target → target is on left side
// Loop ends → target not found → return -1
