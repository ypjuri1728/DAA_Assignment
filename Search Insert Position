class Solution {
    public int searchInsert(int[] arr, int target) {
//         int n = nums.length;
//         for(int i =0;i<n;i++){
//             if(nums[i] >= target){
//                 return i;
//             }
//         }
//         return n;
 int left =0;
    int right = arr.length-1;

        while(left <= right){
        int mid = left+(right-left)/2;
          if(arr[mid] == target){
           return mid;
            }
     else if(arr[mid]<target){
            left = mid+1;
            }
        else {
            right = mid-1;
        }
        }
    return left;//while loop is not right at this point.
}
}
